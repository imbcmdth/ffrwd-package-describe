package ffrwd:describe-sounds;

/// The Audio Spectrogram Transformer as a windowed filter that does native
/// inference. It exports the stream interface, so audio reaches it the way
/// it reaches any module, and imports `wasi:nn` - the standard interface,
/// not anything of ours. It imports no filesystem: the graph file is the
/// host's, and this module only knows the name it was bound to.
world sounds {
  export ffrwd:av/window-filter@0.14.0;

  import wasi:nn/tensor@0.2.0-rc-2024-10-28;
  import wasi:nn/graph@0.2.0-rc-2024-10-28;
  import wasi:nn/inference@0.2.0-rc-2024-10-28;
  import wasi:nn/errors@0.2.0-rc-2024-10-28;
}
