{
  "name": "ffrwd/describe",
  "version": "0.1.0",
  "description": "Four describers over a file, hosted in wasm: clips takes X-CLIP's video tower one shot at a time to a 512-d vector, sounds runs AST over 10s audio windows to AudioSet labels as text rows, embed and embed_text put a sentence embedder (all-MiniLM-L6-v2) under those rows and under a search prompt so cos_similarity can rank one against the other, embed_clip and embed_clip_text do the same with X-CLIP's text tower for ranking against clip_vectors. Speech comes from ffrwd/whisper and ffrwd/vad rather than a describer of its own.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/imbcmdth/ffrwd-package-describe",
  "capabilities": ["nn"],
  "dependencies": {
    "ffrwd/shots": "0.1.0",
    "ffrwd/vad": "0.1.0",
    "ffrwd/wasm": "0.14.0",
    "ffrwd/whisper": "0.1.0"
  },
  "keywords": [
    "describe",
    "clip",
    "xclip",
    "ast",
    "audioset",
    "embedding",
    "vector",
    "search",
    "nn"
  ],
  "lib": {
    "clips": "src/clips.sql",
    "sounds": "src/sounds.sql",
    "embed": "src/embed.sql",
    "embed_text": "src/embed.sql",
    "embed_clip": "src/embed.sql",
    "embed_clip_text": "src/embed.sql"
  },
  "bin": {
    "describe": "recipes/describe.sql",
    "find": "recipes/find.sql"
  },
  "models": {
    "clips": {
      "repo": "imbcmdth/xclip-onnx",
